# Copy to .env and fill in your key. .env is gitignored.
ELEVENLABS_API_KEY=

# Optional — defaults shown.
# Voice ID. Find more at https://api.elevenlabs.io/v1/voices
# 21m00Tcm4TlvDq8ikWAM = "Rachel" (default professional female)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Model. eleven_multilingual_v2 is the high-quality default;
# eleven_turbo_v2_5 is faster/cheaper.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
